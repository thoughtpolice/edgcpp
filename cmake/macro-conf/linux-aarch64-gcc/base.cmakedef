# Native Linux AArch64 configuration (GCC).
import <support/platform/linux/base>
import <support/arch/arm64/base>
import <support/simple-conf/debug/base>

# Linux uses binary128 long double, unlike macOS arm64.
TARG_SUPPORTS_ARM64=1
HOST_ALIGNMENT_REQUIRED=8
TARG_HAS_SIGNED_CHARS=0
TARG_SIZEOF_LONG_DOUBLE=16
TARG_ALIGNOF_LONG_DOUBLE=16
TARG_WCHAR_T_INT_KIND=((an_integer_kind)ik_unsigned_int)
TARG_JMP_BUF_NUM_ELEMENTS=39
TARG_JMP_BUF_ELEMENT_INT_KIND=((an_integer_kind)ik_long_long)
FP_LONG_DOUBLE_IS_80BIT_EXTENDED=0
FP_LONG_DOUBLE_IS_BINARY128=1
LEGACY_TARGET_CONFIGURATION_NAME="linux_aarch64"

# GCC on AArch64 provides _Float128, but not libquadmath or __float80.
# Use EDG's internal floating-point string conversion routines.
USE_QUADMATH_LIBRARY=0
APPROXIMATE_QUADMATH=1
FLOAT80_ENABLING_POSSIBLE=0
INT128_EXTENSIONS_ALLOWED=1
