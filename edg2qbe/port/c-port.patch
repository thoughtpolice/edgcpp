+void edg_cache_move_copy_tokens(a_token_cache *cache,a_token_cache_iterator first,
+                                a_token_cache_iterator last)
+{
+  size_t n = edg_cache_iter_distance(first,last);
+  if (n != 0) {
+    edg_array_reserve(&cache->tokens,cache->tokens.len+n);
+    a_shared_token *source = edg_cache_iter_get(first);
+    a_shared_token *destination =
+                      (a_shared_token*)cache->tokens.data+cache->tokens.len;
+    memcpy(destination,source,n*sizeof(*source));
+    memset(source,0,n*sizeof(*source));
+    cache->tokens.len += n;
+  }
