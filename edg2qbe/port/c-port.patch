+static ptrdiff_t macro_name_index(const char *name, const void *table,
+                                 size_t count, size_t stride, size_t offset)
+{
+  size_t low = 0, high = count;
+  while (low < high) {
+    size_t mid = low + (high - low) / 2;
+    const char *entry = *(const char *const *)
+      ((const char *)table + mid * stride + offset);
+    int comparison = strcmp(name, entry);
+    if (comparison == 0) return (ptrdiff_t)mid;
+    if (comparison < 0) high = mid;
+    else low = mid + 1;
+  }
+  return -1;
+}
 
