+  if (trans_unit_module_entity_scope != NULL) {
+    free_fe(trans_unit_module_entity_scope,sizeof(*trans_unit_module_entity_scope));
+    trans_unit_module_entity_scope=NULL;
+  }
+  module_map_delete(&module_entity_scope_hash_table);
+}
