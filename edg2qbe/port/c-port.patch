+static void cache_word_category(a_module_token_cache_ptr cache,
+                               an_ifc_input_state *input_state,
+                               an_ifc_source_location locus,
+                               an_ifc_word_category category)
+/*
+Add the token(s) corresponding to word to cache.
+*/
+{
+  an_ifc_source_position_hint pos_hint={0}; an_ifc_source_position_hint_init(&pos_hint,cache,locus);
+
+  switch (category.sort) {
+    case ifc_ws_unknown:
+      break;
+    case ifc_ws_source_directive:
+      cache_unmarked_source_directive(input_state->import_decl->module_info, cache,
+                                      category.variant.source_directive);
+      break;
+    case ifc_ws_source_punctuator:
+      cache_source_punctuator(input_state->import_decl->module_info, cache,
+                              category.variant.source_punctuator);
