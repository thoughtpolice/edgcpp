-#define HASH_PTR_SHIFT 6
-#endif /* == 32 */
-#endif /* == 16 */
-#endif /* == 8 */
-#endif /* == 4 */
-#endif /* == 2 */
-#endif /* == 1 */
-  return (uintptr_t)ptr >> HASH_PTR_SHIFT;
