+static size_t token_lower_bound(const a_token_cache *cache,
+                              a_token_sequence_number number,a_boolean ending)
+{
+  size_t lo = 0, hi = cache->tokens.len;
+  while (lo < hi) {
+    size_t mid = lo+(hi-lo)/2;
+    a_shared_token token = *edg_cache_at(cache,mid);
+    a_token_sequence_number seq = ending ?
+                  token->ending_token_sequence_number : token->token_sequence_number;
+    if (seq < number) lo = mid+1;
+    else hi = mid;
+  }
+  return lo;
+}
+void edg_cache_find_first_and_last(const a_token_cache *cache,
+                    a_token_sequence_number first,a_token_sequence_number last,
+                    a_token_cache_iterator *before,a_token_cache_iterator *end)
+{
+  check_assertion(first <= last || first == NO_TOKEN_SEQUENCE_NUMBER ||
+                  last == NO_TOKEN_SEQUENCE_NUMBER);
+  *before = edg_cache_iterator(cache,-1);
+  *end = edg_cache_get_last_token_iter(cache);
+  if (first != NO_TOKEN_SEQUENCE_NUMBER) {
+    size_t idx = token_lower_bound(cache,first,FALSE);
+    *before = edg_cache_iterator(cache,(int)idx-1);
+    check_assertion_or_expect_error_str(
+       idx != 0 || (cache->tokens.len != 0 &&
+                    (*edg_cache_at(cache,0))->token_sequence_number == first),
+       "a_token_cache::find_first_and_last: first_tsn missing");
+  }
+  if (last != NO_TOKEN_SEQUENCE_NUMBER) {
+    size_t idx = token_lower_bound(cache,last+1,TRUE);
+    check_assertion_or_expect_error_str(
+           idx != 0,"a_token_cache::find_first_and_last: last_tsn missing");
+    if (idx != 0) *end = edg_cache_iterator(cache,(int)idx-1);
+  }
+}
 
+static void scanning_cache_init(a_scanning_token_cache *cache,a_boolean reusable,
+                                Edg_array *pool,size_t capacity)
+{
+  if (pool->len == 0) cache->backing_cache = edg_cache_new(reusable,capacity);
+  else {
+    cache->backing_cache = *(a_token_cache**)edg_array_at(pool,pool->len-1);
+    --pool->len;
+    cache->backing_cache->is_reusable = reusable;
+  }
+}
+void edg_scanning_cache_init(a_scanning_token_cache *cache,a_boolean reusable)
+{ scanning_cache_init(cache,reusable,avail_scanning_token_caches,50); }
+void edg_tiny_scanning_cache_init(a_tiny_scanning_token_cache *cache,
+                                  a_boolean reusable)
+{ scanning_cache_init(cache,reusable,avail_tiny_scanning_token_caches,10); }
+void edg_scanning_cache_destroy(a_scanning_token_cache *cache)
+{
+  if (cache->backing_cache != NULL) {
+    size_t i = avail_scanning_token_caches->len;
+    edg_cache_clear(cache->backing_cache);
+    while (i != 0 && (*(a_token_cache**)edg_array_at(
+              avail_scanning_token_caches,i-1))->tokens.cap >
+                                         cache->backing_cache->tokens.cap) --i;
+    edg_array_insert(avail_scanning_token_caches,i,&cache->backing_cache,1);
+    cache->backing_cache = NULL;
+  }
+}
+void edg_tiny_scanning_cache_destroy(a_tiny_scanning_token_cache *cache)
+{
+  if (cache->backing_cache != NULL) {
+    edg_cache_clear(cache->backing_cache);
+    edg_array_push(avail_tiny_scanning_token_caches,&cache->backing_cache);
+    cache->backing_cache = NULL;
+  }
+}
+void edg_scanning_cache_move(a_scanning_token_cache *dst,
+                              a_scanning_token_cache *src)
+{
+  a_token_cache *swap = dst->backing_cache;
+  dst->backing_cache = src->backing_cache;
+  src->backing_cache = swap;
+}
 
