+{ edg_cache_remove_token_range(cache,it,edg_cache_end(cache)); }
+void edg_cache_remove_non_pragma_tokens_after(a_token_cache *cache,
+                                              a_token_cache_iterator it)
+{
+#if EXTRA_SOURCE_POSITIONS_IN_IL
+  a_shared_token last_non_pragma = NULL;
+  for (size_t i = (size_t)it.offset+1; i < cache->tokens.len; ++i) {
+    a_shared_token token = *edg_cache_at(cache,i);
+    if (!edg_token_is_pragma(token)) last_non_pragma = token;
+  }
+  if (last_non_pragma != NULL) {
+    a_cached_token replacement;
+    a_shared_token *slot = edg_cache_iter_get(it);
+    edg_token_copy(&replacement,*slot);
+    replacement.end_source_position = last_non_pragma->end_source_position;
+    a_shared_token new_token = edg_shared_token_move(&replacement);
+    edg_shared_token_release(*slot);
+    *slot = new_token;
+  }
+#endif
+  size_t write_index = (size_t)it.offset+1;
+  for (size_t read_index = write_index; read_index < cache->tokens.len;
+       ++read_index) {
+    a_shared_token token = *edg_cache_at(cache,read_index);
+    if (edg_token_is_pragma(token)) {
+      if (write_index != read_index) *edg_cache_at(cache,write_index) = token;
+      ++write_index;
+    } else {
+      edg_shared_token_release(token);
+    }
+  }
+  cache->tokens.len = write_index;
+}
