+static void pch_executable_identity(char digest_hex[65])
+/*
+Hash the executing file, rather than its load addresses, so the identity is
+stable under ASLR but differs for separately built compiler binaries.
+*/
+{
+  static const char hex_digits[] = "0123456789abcdef";
+  unsigned char buffer[16384];
+  a_sha256_hash hash;
+  a_sha256_digest digest;
+  FILE *file = fopen("/proc/self/exe", "rb");
+  size_t count;
+  int read_error = 0;
+
+  if (file == NULL) pch_executable_identity_error("open", errno);
+  edg_sha256_init(&hash);
+  while ((count = fread(buffer, 1, sizeof(buffer), file)) != 0) {
+    edg_sha256_update(&hash, buffer, count);
+  }
+  if (ferror(file)) read_error = errno != 0 ? errno : EIO;
+  if (fclose(file) != 0 && read_error == 0) {
+    pch_executable_identity_error("close", errno);
+  }
+  if (read_error != 0) pch_executable_identity_error("read", read_error);
+  digest = edg_sha256_compute_digest(&hash);
+  for (size_t i = 0; i < sizeof(digest.bytes); ++i) {
+    digest_hex[2*i] = hex_digits[digest.bytes[i] >> 4];
+    digest_hex[2*i + 1] = hex_digits[digest.bytes[i] & 15];
+  }
+  digest_hex[64] = '\0';
+}
