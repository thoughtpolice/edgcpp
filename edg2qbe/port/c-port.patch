+{
+  if (edg_token_is_pragma(token)) return 0;
+  if (edg_token_is_identifier(token)) {
+    const char *identifier = token->extra_info.locator.symbol_header->identifier;
+    a_string_view view = edg_string_view(identifier,strlen(identifier));
+    return (uintptr_t)edg_string_view_hash(&view);
+  }
+  if (edg_token_is_constant(token)) {
+    return (uintptr_t)hash_constant(token->extra_info.constant);
+  }
+  if (edg_token_is_asm_string(token)) return hash_string(token->extra_info.asm_string);
+  if (edg_token_is_ud_literal(token)) {
+    return (uintptr_t)hash_constant(token->extra_info.ud_lit.spelling_con);
+  }
+  if (edg_token_is_unresolved_ud_literal(token)) unexpected_condition();
+  return (uintptr_t)token->token;
+}
