+/*
+This structure represents a stream of IFC SourceWords.  This is conceptually
+similar to the front end's token stream.  However, unlike the token stream,
+the IFC word stream is used to form tokens, and is not directly parsed into IL
+entities.
+*/
+struct an_ifc_word_stream {
+a_source_word_sequence
+                sequence;
+an_ifc_index_type
+                curr_word_idx;
+an_ifc_source_word
+                curr_word;
+};
+
+static void an_ifc_word_stream_init(an_ifc_word_stream *self, const a_source_word_sequence sequence_val)
+{
+memset(self,0,sizeof(*self));
+self->sequence = sequence_val;
+self->curr_word_idx = 0;
+}
+
+static uint32_t an_ifc_word_stream_num_words_read(an_ifc_word_stream *self)
+{ return self->curr_word_idx - 1; };  /* an_ifc_word_stream */
+
+
+static a_boolean an_ifc_word_stream_get_word(an_ifc_word_stream *self)
+{
+  a_boolean               result = FALSE;
+  Opt_an_ifc_source_word opt_word=ifc_sequence_get_an_ifc_source_word(self->sequence,self->curr_word_idx++);
+
+  if ((opt_word).has_value) {
+    self->curr_word = (opt_word).value;
+    result = TRUE;
+  }  /* if */
+  return result;
+}  /* an_ifc_word_stream::get_word */
+
+
+static an_ifc_source_word an_ifc_word_stream_current_word(an_ifc_word_stream *self)
+{
+  return self->curr_word;
+}  /* an_ifc_word_stream::current_word */
+
+
+static a_boolean an_ifc_word_stream_has_next_word(an_ifc_word_stream *self, 
+                          /* Defaulted: */  unsigned lookahead)
+{
+  return self->curr_word_idx + lookahead < (self->sequence).cardinality;
+}  /* an_ifc_word_stream::has_next_word */
+
+
+static Opt_an_ifc_source_word an_ifc_word_stream_next_word(an_ifc_word_stream *self, 
+                                    /* Defaulted: */  unsigned lookahead)
+{
+  check_assertion(an_ifc_word_stream_has_next_word(self,lookahead));
+  return ifc_sequence_get_an_ifc_source_word(self->sequence,self->curr_word_idx + lookahead);
+}  /* an_ifc_word_stream::next_word */
+
