+#define Deftgt T_arm64
diff --git a/main.c b/main.c
--- a/main.c
+++ b/main.c
@@ -2,6 +2,21 @@
 #include "config.h"
 #include <ctype.h>
 #include <getopt.h>
+#include <setjmp.h>
+#include <errno.h>
+
+/* QBE owns global compiler state: these entry points are serial, not reentrant.
+ * Parse errors return to the stream caller; invariant failures still abort. */
+static jmp_buf compile_error;
+static int compiling;
+
+void
+il2qbe_qbe_error(void)
+{
+	if (compiling)
+		longjmp(compile_error, 1);
+	exit(1);
+}
 
 Target T;
 
@@ -128,7 +143,39 @@
 }
 
 int
-main(int ac, char *av[])
+il2qbe_qbe_compile(FILE *input, FILE *output, const char *target,
+                  const char *name)
+{
+	Target **t;
+
+	for (t=tlist; *t && strcmp(target, (*t)->name); t++)
+		;
+	if (!*t) {
+		fprintf(stderr, "qbe: unknown target '%s'\n", target);
+		return 1;
+	}
+	T = **t;
+	outf = output;
+	dbg = 0;
+	memset(debug, 0, sizeof debug);
+	if (setjmp(compile_error)) {
+		compiling = 0;
+		freeall();
+		return 1;
+	}
+	compiling = 1;
+	parse(input, (char *)name, dbgfile, data, func);
+	T.emitfin(output);
+	compiling = 0;
+	if (ferror(input) || ferror(output) || fflush(output)) {
+		fprintf(stderr, "qbe: stream I/O failed: %s\n", strerror(errno));
+		return 1;
+	}
+	return 0;
+}
+
+int
+il2qbe_qbe_main(int ac, char *av[])
 {
 	Target **t;
 	FILE *inf, *hf;
@@ -137,6 +184,9 @@
 
 	T = Deftgt;
 	outf = stdout;
+	optind = 0;
+	dbg = 0;
+	memset(debug, 0, sizeof debug);
 	while ((c = getopt(ac, av, "hd:o:t:")) != -1)
 		switch (c) {
 		case 'd':
@@ -202,11 +252,23 @@
 			}
 		}
 		parse(inf, f, dbgfile, data, func);
-		fclose(inf);
+		if (ferror(inf)) {
+			fprintf(stderr, "cannot read '%s': %s\n", f, strerror(errno));
+			return 1;
+		}
+		if (inf != stdin && fclose(inf)) {
+			fprintf(stderr, "cannot close '%s': %s\n", f, strerror(errno));
+			return 1;
+		}
 	} while (++optind < ac);
 
 	if (!dbg)
 		T.emitfin(outf);
 
-	exit(0);
-}
+	if (ferror(outf) || fflush(outf) ||
+	    (outf != stdout && fclose(outf))) {
+		fprintf(stderr, "cannot write QBE output: %s\n", strerror(errno));
+		return 1;
+	}
+	return 0;
+}
