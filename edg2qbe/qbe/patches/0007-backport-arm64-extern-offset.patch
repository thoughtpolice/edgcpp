Subject: [PATCH 07/11] arm64: fix extern with offset

Backport upstream commit 80d745c842b4dafe02a69a6eb15e4f8ff72d42fa.

---
diff --git a/arm64/emit.c b/arm64/emit.c
--- a/arm64/emit.c
+++ b/arm64/emit.c
@@ -303,12 +303,13 @@ loadaddr(Con *c, char *rn, E *e)
 			    "\tadd\tR, R, #:tprel_lo12_nc:SO\n";
 		break;
 	case SExt:
+		assert(c->bits.i == 0);
 		if (T.apple)
-			s = "\tadrp\tR, S@gotpageO\n"
-			    "\tldr\tR, [R, S@gotpageoffO]\n";
