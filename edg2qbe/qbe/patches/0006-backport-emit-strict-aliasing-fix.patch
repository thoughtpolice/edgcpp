Subject: [PATCH 06/11] emit: fix aliasing-breaking pointer dereference via union

Backport upstream commit fa19d3c974dae37cf335781300d0e4791be0d87c.

---
diff --git a/emit.c b/emit.c
--- a/emit.c
+++ b/emit.c
@@ -160,6 +160,7 @@ emitfin(FILE *f, char *sec[3])
 	Asmbits *b;
 	int lg, i;
 	union { int32_t i; float f; } u;
+	union { int64_t i; double f; } uu;
 
 	if (!stash)
 		return;
@@ -178,13 +179,13 @@ emitfin(FILE *f, char *sec[3])
 						"\n\t.quad %"PRId64
 						"\n\t.quad 0\n\n",
 						(int64_t)b->n);
-				else if (lg == 3)
+				else if (lg == 3) {
+					uu.i = b->n;
 					fprintf(f,
 						"\n\t.quad %"PRId64
 						" /* %f */\n\n",
-						(int64_t)b->n,
-						*(double *)&b->n);
-				else if (lg == 2) {
+						uu.i, uu.f);
+				} else if (lg == 2) {
 					u.i = b->n;
 					fprintf(f,
 						"\n\t.int %"PRId32
