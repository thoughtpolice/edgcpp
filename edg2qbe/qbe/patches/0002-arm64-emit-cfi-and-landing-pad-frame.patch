Subject: [PATCH 02/11] arm64: emit CFI and reserve landing-pad frame state

Describe frame setup, callee-save locations, and teardown with DWARF CFI. Reserve the fixed unwinder and edge-state area required by landing-pad calls, and give every basic block a stable assembly label.

---
diff --git a/arm64/emit.c b/arm64/emit.c
--- a/arm64/emit.c
+++ b/arm64/emit.c
@@ -7,6 +7,7 @@
 	Fn *fn;
 	uint64_t frame;
 	uint padding;
+	uint scratch;
 };
 
 #define CMP(X) \
@@ -161,7 +162,7 @@
 		else
 			return 16 + e->frame - (s+2);
 	} else
-		return 16 + e->padding + 4 * s;
+		return 16 + e->scratch + e->padding + 4 * s;
 }
 
 static void
@@ -504,6 +525,18 @@
 	int *r;
 	uint o;
 	uint64_t f;
+	Blk *b;
+	Ins *i;
+	Con *c;
+
+	for (b=e->fn->start; b; b=b->link)
+		for (i=b->ins; i!=&b->ins[b->nins]; i++)
+			if (i->op == Ocall && rtype(i->arg[0]) == RCon) {
+				c = &e->fn->con[i->arg[0].val];
+				if (c->type == CAddr &&
+				    !strncmp(str(c->sym.id), "__edg_qbe_lpad_", 15))
+					e->scratch = 32; /* unwinder pair and edge status */
+			}
 
 	for (o=0, r=arm64_rclob; *r>=0; r++)
 		o += 1 & (e->fn->reg >> *r);
@@ -511,7 +544,7 @@
 	f = (f + 3) & -4;
 	o += o & 1;
 	e->padding = 4*(f-e->fn->slot);
-	e->frame = 4*f + 8*o;
+	e->frame = e->scratch + 4*f + 8*o;
 }
 
 /*
@@ -533,7 +566,12 @@
   |   locals    |  |
   |    ...      |  |
   +-------------+  |
-  | e->padding  |  v
+  | e->padding  |  |
+  +-------------+  |
+  | edge status |  |
+  |  (padded)   |  |
+  | unwinder x0 |  |
+  | unwinder x1 |  v
   +-------------+
   |  saved x29  |
   |  saved x30  |
@@ -550,7 +588,7 @@
 	#undef X
 	};
 	static int id0;
-	int s, n, c, lbl, *r;
+	int s, n, c, *r;
 	uint64_t o;
 	Blk *b, *t;
 	Ins *i;
@@ -560,76 +598,86 @@
 	if (T.apple)
 		e->fn->lnk.align = 4;
 	emitfnlnk(e->fn->name, &e->fn->lnk, e->f);
-	fputs("\thint\t#34\n", e->f);
+	fputs("\t.cfi_startproc\n\thint\t#34\n", e->f);
 	framelayout(e);
-
+	o = e->frame + 16;
+	if (e->fn->vararg && !T.apple)
+		o += 192;
 	if (e->fn->vararg && !T.apple) {
-		for (n=7; n>=0; n--)
+		for (n=7; n>=0; n--) {
 			fprintf(e->f, "\tstr\tq%d, [sp, -16]!\n", n);
