+			fprintf(e->f, "\t.cfi_def_cfa_offset %d\n", (8-n)*16);
+		}
+		for (n=7; n>=0; n-=2) {
 			fprintf(e->f, "\tstp\tx%d, x%d, [sp, -16]!\n", n-1, n);
-	}
-
-	if (e->frame + 16 <= 512)
+			fprintf(e->f, "\t.cfi_def_cfa_offset %d\n", 128+(9-n)*8);
+		}
+	}
+
+	if (e->frame + 16 <= 512) {
 		fprintf(e->f,
 			"\tstp\tx29, x30, [sp, -%"PRIu64"]!\n",
 			e->frame + 16
 		);
-	else if (e->frame <= 4095)
-		fprintf(e->f,
-			"\tsub\tsp, sp, #%"PRIu64"\n"
-			"\tstp\tx29, x30, [sp, -16]!\n",
-			e->frame
-		);
-	else if (e->frame <= 65535)
-		fprintf(e->f,
-			"\tmov\tx16, #%"PRIu64"\n"
-			"\tsub\tsp, sp, x16\n"
-			"\tstp\tx29, x30, [sp, -16]!\n",
-			e->frame
-		);
-	else
-		fprintf(e->f,
-			"\tmov\tx16, #%"PRIu64"\n"
-			"\tmovk\tx16, #%"PRIu64", lsl #16\n"
-			"\tsub\tsp, sp, x16\n"
-			"\tstp\tx29, x30, [sp, -16]!\n",
-			e->frame & 0xFFFF, e->frame >> 16
-		);
-	fputs("\tmov\tx29, sp\n", e->f);
-	s = (e->frame - e->padding) / 4;
+	} else {
+		if (e->frame <= 4095)
+			fprintf(e->f, "\tsub\tsp, sp, #%"PRIu64"\n", e->frame);
+		else {
+			fprintf(e->f, "\tmov\tx16, #%"PRIu64"\n", e->frame & 0xFFFF);
+			if (e->frame > 65535)
+				fprintf(e->f, "\tmovk\tx16, #%"PRIu64", lsl #16\n",
+					e->frame >> 16);
+			fputs("\tsub\tsp, sp, x16\n", e->f);
+		}
+		fprintf(e->f, "\t.cfi_def_cfa_offset %"PRIu64"\n", o - 16);
+		fputs("\tstp\tx29, x30, [sp, -16]!\n", e->f);
+	}
+	fprintf(e->f,
+		"\t.cfi_def_cfa_offset %"PRIu64"\n"
+		"\t.cfi_offset 29, -%"PRIu64"\n"
+		"\t.cfi_offset 30, -%"PRIu64"\n"
+		"\tmov\tx29, sp\n"
+		"\t.cfi_def_cfa_register 29\n",
+		o, o, o - 8
+	);
+	s = (e->frame - e->scratch - e->padding) / 4;
 	for (r=arm64_rclob; *r>=0; r++)
 		if (e->fn->reg & BIT(*r)) {
 			s -= 2;
 			i = &(Ins){.arg = {TMP(*r), SLOT(s)}};
 			i->op = *r >= V0 ? Ostored : Ostorel;
 			emitins(i, e);
-		}
-
-	for (lbl=0, b=e->fn->start; b; b=b->link) {
-		if (lbl || b->npred > 1)
-			fprintf(e->f, "%s%d:\n", T.asloc, id0+b->id);
+			fprintf(e->f, "\t.cfi_offset %d, %"PRId64"\n",
+				*r >= V0 ? 64 + *r - V0 : *r - R0,
+				(int64_t)slot(SLOT(s), e) - (int64_t)o);
+		}
+
+	for (b=e->fn->start; b; b=b->link) {
+		fprintf(e->f, "%sbb%d:\n", T.asloc, id0+b->id);
 		for (i=b->ins; i!=&b->ins[b->nins]; i++)
 			emitins(i, e);
-		lbl = 1;
 		switch (b->jmp.type) {
 		case Jhlt:
 			fprintf(e->f, "\tbrk\t#1000\n");
 			break;
 		case Jret0:
-			s = (e->frame - e->padding) / 4;
+			fputs("\t.cfi_remember_state\n", e->f);
+			s = (e->frame - e->scratch - e->padding) / 4;
 			for (r=arm64_rclob; *r>=0; r++)
 				if (e->fn->reg & BIT(*r)) {
 					s -= 2;
 					i = &(Ins){Oload, 0, TMP(*r), {SLOT(s)}};
 					i->cls = *r >= V0 ? Kd : Kl;
 					emitins(i, e);
+					fprintf(e->f, "\t.cfi_restore %d\n",
+						*r >= V0 ? 64 + *r - V0 : *r - R0);
 				}
 			if (e->fn->dynalloc)
 				fputs("\tmov sp, x29\n", e->f);
 			o = e->frame + 16;
 			if (e->fn->vararg && !T.apple)
 				o += 192;
+			fprintf(e->f, "\t.cfi_def_cfa 31, %"PRIu64"\n", o);
 			if (o <= 504)
 				fprintf(e->f,
 					"\tldp\tx29, x30, [sp], %"PRIu64"\n",
@@ -638,35 +686,41 @@
 			else if (o - 16 <= 4095)
 				fprintf(e->f,
 					"\tldp\tx29, x30, [sp], 16\n"
+					"\t.cfi_def_cfa_offset %"PRIu64"\n"
+					"\t.cfi_restore 29\n\t.cfi_restore 30\n"
 					"\tadd\tsp, sp, #%"PRIu64"\n",
-					o - 16
+					o - 16, o - 16
 				);
 			else if (o - 16 <= 65535)
 				fprintf(e->f,
 					"\tldp\tx29, x30, [sp], 16\n"
+					"\t.cfi_def_cfa_offset %"PRIu64"\n"
+					"\t.cfi_restore 29\n\t.cfi_restore 30\n"
 					"\tmov\tx16, #%"PRIu64"\n"
 					"\tadd\tsp, sp, x16\n",
-					o - 16
